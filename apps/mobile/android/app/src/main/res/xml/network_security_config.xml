<?xml version="1.0" encoding="utf-8"?>
<!--
  A RemoteCode client talks to a host the user runs. Only the device's own
  loopback aliases may use plain HTTP — 127.0.0.1 for an adb-forwarded host and
  10.0.2.2 for the emulator's host loopback. Every other address must be HTTPS,
  which is where the API already requires TLS.
-->
<network-security-config>
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">127.0.0.1</domain>
    <domain includeSubdomains="false">localhost</domain>
    <domain includeSubdomains="false">10.0.2.2</domain>
  </domain-config>
</network-security-config>
